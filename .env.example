# Entergram PRO API key, Settings > Developers. Scopes: workspace.read, accounts.read,
# contacts.read, chats.read, messages.read, members.read, custom_fields.read, events.read.
# Leave the key's IP allowlist EMPTY. Vercel egress IPs are not fixed.
ENTERGRAM_API_KEY=
ENTERGRAM_BASE_URL=https://api.entergram.com
# The connected account whose group memberships make history readable. Defaults to
# the readerAccountId in config/team.json.
# ENTERGRAM_READER_ACCOUNT_ID=

# Slack. The bot must be invited to the channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Public URL of this dashboard, used for the links inside alerts. Falls back to NEXTAUTH_URL.
DASHBOARD_URL=https://entergram-watch.vercel.app

# Vercel cron auth. Any long random string.
CRON_SECRET=

# KV state and dedupe (the Upstash integration sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Thresholds
QUIET_DAYS=7                 # "no contact" and the Slack alert line
UNANSWERED_HOURS=12          # player message with no reply counts as waiting after this
# SCOPE_ACCOUNTS=Thrill_VIP_Ops   # only groups these connected accounts sit in; defaults to the shared accounts in config/team.json

# Alerts
URGENT_ALERTS=on             # off = only the 7-day alert posts to Slack
ALERT_COOLDOWN_HOURS=24      # one alert per conversation per this many hours, whatever the kind
ALERT_MAX_LATE_DAYS=2        # a silence posts only if it crossed the 7-day line this recently
URGENT_MAX_AGE_HOURS=24      # a churn signal posts only for a player message this recent
UNHAPPY_MAX_AGE_DAYS=7       # a negative mood older than this no longer marks the player unhappy
MAX_ALERTS_PER_RUN=15        # the rest post on later ticks
OUTAGE_ALERT_AFTER_FAILURES=3

# Scan pacing
FULL_SWEEP_MINUTES=60        # full chat list this often; other ticks fetch only changed chats
HISTORY_BUDGET=80            # history reads per incremental tick
HISTORY_BUDGET_FULL=150      # history reads per full sweep
ROTATION_HOURS=6             # re-read an unchanged chat's history once its facts are this old
EVENTS_PAGES_PER_TICK=25     # event stream pages (500 events each) followed per tick, 0 disables
EVENTS_BACKFILL_DAYS=10      # how far back the first run reads the stream
SCAN_SOFT_DEADLINE_MS=200000

# Sentiment. Whichever key is present picks the provider; SENTIMENT_PROVIDER=none disables the model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
SENTIMENT_BUDGET=40
SENTIMENT_WINDOW_MINUTES=60   # the exchange the mood is read from: this long before the player's last message
SENTIMENT_MIN_MESSAGES=3      # and never fewer than this many player messages

# Google SSO for the dashboard. OAuth consent screen User Type = Internal,
# redirect URI https://<domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://<your-vercel-domain>
ALLOWED_HD=paradym.io
# MONITORING_EMAILS=anri.akhaladze@paradym.io,shane.austin@paradym.io   # see Logs, manage access; always allowed in
# ALLOWED_EMAILS=                                                        # allowed in, on top of the list managed under Logs
# BLOCKED_EMAILS=                                                        # refused at sign-in, on top of the list managed under Logs
