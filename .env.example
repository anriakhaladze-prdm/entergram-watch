# Entergram PRO API key, Settings > Developers.
# Scopes needed: workspace.read, accounts.read, contacts.read, chats.read, messages.read, members.read
# Leave the key's IP allowlist EMPTY. Vercel egress IPs are not fixed.
ENTERGRAM_API_KEY=
ENTERGRAM_BASE_URL=https://api.entergram.com

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Vercel cron auth. Any long random string.
CRON_SECRET=

# KV dedupe and state (Upstash integration sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Thresholds
QUIET_DAYS=7
UNANSWERED_HOURS=12

# Sentiment. Whichever key is present picks the provider; set SENTIMENT_PROVIDER
# to openai, anthropic or none to force it. Rules still run with no key at all.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
SENTIMENT_BUDGET=40

# Google SSO for the dashboard. Same setup as sonar-kyt: OAuth consent screen
# User Type = Internal, redirect URI https://<domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://<your-vercel-domain>
ALLOWED_HD=paradym.io
